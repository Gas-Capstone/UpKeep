# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Same project the app uses. The anon key is safe to share within the team:
# it ships inside the React Native bundle anyway, and RLS is what actually
# protects the data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# A test user you created in the Supabase dashboard.
# Used only by get_token.py. Use a throwaway account, not a real one.
TEST_USER_EMAIL=you@example.com
TEST_USER_PASSWORD=change-me

# Output of get_token.py. Expires after ~1 hour — re-run and replace.
# Only needed for testing the server directly; the app sends its own token.
TEST_JWT=

# Lets a request with no token fall back to TEST_JWT. Leave this unset once
# the server is reachable through the tunnel: it would let anyone who finds
# the URL act as the test user without sending a token.
ALLOW_TEST_JWT=

# The Ollama model to use. Use qwen3:8b if you skipped the /save step
# described in the README.
MODEL=qwen3-upkeep
