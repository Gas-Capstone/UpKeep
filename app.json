{
  "expo": {
    "name": "UpKeep",
    "slug": "Wellness-App",
    "owner": "team-gas",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/upkeep-logo.png",
    "scheme": "wellnessapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/upkeep-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B9E96",
        "foregroundImage": "./assets/images/upkeep-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gas.upkeep"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/upkeep-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B9E96",
          "image": "./assets/images/upkeep-logo.png",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2242acf9-e19d-48b6-b7e2-0ce01b04802b"
      }
    }
  }
}
